# ============================================================
# Claves de conexión a Supabase
# ------------------------------------------------------------
# 1. Copia este archivo y renómbralo a  .env.local
# 2. Pega los valores desde tu proyecto de Supabase
#    (Project Settings → API)
# 3. Reinicia el servidor de desarrollo (npm run dev)
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Conexión con Google Calendar (opcional)
# ------------------------------------------------------------
# Desde Google Cloud → Credenciales → ID de cliente de OAuth
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
